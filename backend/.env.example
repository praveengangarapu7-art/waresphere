# Copy this file to .env and adjust values for your local PostgreSQL instance.

# App
APP_NAME=WareSphere API
APP_ENV=development

# SQLAlchemy connection string (authoritative — read directly by app/config.py)
DATABASE_URL=postgresql+psycopg2://waresphere_user:waresphere_password@localhost:5432/waresphere

# Individual components, for reference if you assemble DATABASE_URL yourself
POSTGRES_USER=waresphere_user
POSTGRES_PASSWORD=waresphere_password
POSTGRES_DB=waresphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Separate connection string for PostgreSQL-backed tests only
# (tests/test_*postgres*.py). Has NO default and is never derived from
# DATABASE_URL above — those tests create/drop databases and delete rows,
# and must only ever run against a database you have explicitly pointed
# them at. Leave unset to skip PostgreSQL-backed tests entirely (SQLite
# tests are unaffected). Point this at its own disposable instance/
# container — never at a shared or production database.
TEST_DATABASE_URL=

# JWT authentication (Phase 2A). JWT_SECRET_KEY has NO default in code — the
# app raises a clear error the first time a token is issued/verified if it
# is left unset, rather than a hardcoded secret ever being checked in here
# or in source. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
